# ─────────────────────────────────────────────
# ParkPulse AI — Backend Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Dataset
# URL to the raw CSV file (can be local path or HTTP URL)
DATASET_URL=https://uc.hackerearth.com/he-public-ap-south-1/jan%20to%20may%20police%20violation_anonymized791b166.csv
# Or set a local path if you've downloaded it:
# DATASET_LOCAL_PATH=./data/violations.csv

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://parkpulse:parkpulse@localhost:5432/parkpulse_db

# If using SQLite for local dev without Postgres (set to "sqlite" to enable)
DB_MODE=sqlite
SQLITE_PATH=./parkpulse.db

# API Keys
MAPPLS_CLIENT_ID=96dHZVzsAuugfPwintqwiWw6-Y52iLRyz6ExNb2yXTZrzrVnJp06at0NyFN3PO4YQY43AoXCNTQOPXcdjdEhcw==
MAPPLS_CLIENT_SECRET=lrFxI-iSEg9wvtMmQE1I9KZvl9UFpedkxyZfeMLx3IHwZMqFSgydseLVYudLa7BRO7cLQdIZc2QD-iJfctdFyqHUl1Eq2Tku

# App config
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ML model cache directory
MODEL_CACHE_DIR=./model_cache

# Optional: Redis for caching precomputed aggregates
# REDIS_URL=redis://localhost:6379/0